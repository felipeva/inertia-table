{
    "name": "@felipeva/inertiajs-table-react",
    "description": "A serie of React hooks to handle tables with InertiaJS",
    "keywords": [
        "inertiajs",
        "react",
        "table",
        "inertia",
        "inertia-react"
    ],
    "version": "2.0.0",
    "module": "./dist/inertiajs-table-react.es.js",
    "types": "./dist/index.d.ts",
