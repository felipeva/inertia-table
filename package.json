    "author": "Felipe Valencia <pipeedev@gmail.com>",
    "license": "MIT",
    "devDependencies": {
        "@inertiajs/react": "^2.3.29",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "prettier": "3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^4.5.4"
    },
    "peerDependencies": {
        "@inertiajs/react": "^2.0.0 || ^3.0.0",
        "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@lifespikes/cogent-ts": "^0.1.4"
